{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserId": 0,
    "PollingTimeoutSeconds": 30
  },
  "AllowedHosts": "*"
}
