# Скопируй в .env и заполни. .env в git не попадает.
POSTGRES_PASSWORD=local_dev_password

# @BotFather → токен; свой Telegram ID — у @userinfobot
Telegram__BotToken=
Telegram__AllowedUserId=

# Генерация контента: OpenAICompatible (OpenRouter по умолчанию) или Anthropic
Content__Provider=OpenAICompatible

# https://openrouter.ai/keys
OpenAICompatible__ApiKey=
# OpenAICompatible__Model=deepseek/deepseek-v4-pro-0813
# OpenAICompatible__BaseUrl=https://openrouter.ai/api/v1

# Только если Content__Provider=Anthropic
# Anthropic__ApiKey=

# Необязательно: fine-grained token без прав (только публичные репозитории). Без него — 60 запросов/час.
GitHub__Token=
